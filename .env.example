# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_PIN: PIN keamanan 4 digit khusus server untuk masuk ke dashboard admin NAFMA.
# Hanya disimpan di server (jangan pernah diawali VITE_).
ADMIN_ACCESS_PIN="4321"

# ADMIN_SESSION_SECRET: Kunci acak untuk menandatangani cookie sesi admin di server.
ADMIN_SESSION_SECRET="ubah-dengan-kunci-rahasia-panjang-anda"

# SMTP Email Notification (Server-only, opsional untuk pengiriman email otomatis)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Google Maps Service Portal <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL="lulukqueen17@gmail.com"

