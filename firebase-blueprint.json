    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "Permohonan booking jasa yang diajukan customer dan diproses oleh admin.",
      "type": "object",
      "properties": {
        "bookingCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^BK-[A-Z0-9-]+$"
        },
        "lookupHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "customerWhatsapp": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30
        },
        "businessName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "googleMapsUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "pattern": "^https?://"
        },
        "businessCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "businessAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 250
        },
        "businessCity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "packageTier": {
          "type": "string",
          "maxLength": 60
        },
        "packagePrice": {
          "type": "number"
        },
        "serviceId": {
          "type": "string",
          "maxLength": 128
        },
        "serviceType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1500
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending_approval", "revision_requested", "approved", "in_progress", "waiting_for_customer", "completed", "rejected"]
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 600
        },
        "linkedBusinessId": {
          "type": "string",
          "maxLength": 128
        },
        "submittedAtLabel": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "bookingCode",
        "lookupHash",
        "customerName",
        "customerEmail",
        "customerWhatsapp",
        "businessName",
        "googleMapsUrl",
        "businessCategory",
        "businessAddress",
        "businessCity",
        "serviceType",
        "status",
        "submittedAtLabel",
        "createdAt",
        "updatedAt"
      ]
    },
