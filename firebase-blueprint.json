{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Lokasi bisnis Google Maps yang dikelola penuh oleh admin.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nama lengkap lokasi bisnis."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Kategori usaha."
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "description": "Alamat lengkap lokasi bisnis."
        },
        "city": {
          "type": "string",
          "maxLength": 80,
          "description": "Kota atau kabupaten lokasi bisnis."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Nomor telepon atau WhatsApp bisnis."
        },
        "openingHours": {
          "type": "string",
          "maxLength": 120,
          "description": "Informasi jam buka bisnis."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Deskripsi singkat mengenai bisnis."
        },
        "googleReviewUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^https?://",
          "description": "Tautan langsung menuju halaman ulasan/profil Google Maps bisnis."
        },
        "coverImageUrl": {
          "type": "string",
          "maxLength": 1500,
          "description": "URL gambar sampul bisnis."
        },
        "isActive": {
          "type": "boolean",
          "description": "Menentukan apakah lokasi bisnis aktif di portal publik."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID admin pembuat data bisnis."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan dokumen di server."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan terakhir di server."
        }
      },
      "required": [
        "name",
        "category",
        "address",
        "googleReviewUrl",
        "isActive",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
